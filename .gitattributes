# Under CRLF a PowerShell backtick escapes the CR, not the newline, breaking line continuations.
.github/workflows/*.yml text eol=lf

# Bash in the bind-mounted Linux container dies on a trailing \r that core.autocrlf would add.
*.sh text eol=lf
*.bash text eol=lf
resources/models/models.lock text eol=lf

# appimagetool refuses a desktop entry with CR line ends, which a Windows checkout would give it.
*.desktop text eol=lf

# Keep the patched crates' source lines stable across Windows checkouts.
third_party/tract-linalg-0.23.8/** text=auto eol=lf
third_party/burn-dispatch-0.22.1/** text=auto eol=lf

# Packaged license texts are pinned by SHA-256, so their bytes must not depend on the checkout.
/LICENSE text eol=lf
packaging/licenses/** -text

# cmd.exe launchers use Windows line endings.
packaging/windows/*.cmd text eol=crlf
