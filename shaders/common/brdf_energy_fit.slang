// The uniform cubic B-spline, nonzero on (-2, 2).
float ggx_energy_basis(float x)
{
    float t = abs(x);
    float inner = 2.0 / 3.0 - t * t + 0.5 * t * t * t;
    float outer = (2.0 - t) * (2.0 - t) * (2.0 - t) / 6.0;
    return t < 1.0 ? inner : (t < 2.0 ? outer : 0.0);
}

