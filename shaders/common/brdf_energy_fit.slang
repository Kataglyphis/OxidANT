// The uniform cubic B-spline's four weights in a cell, at fraction f of it.
float4 ggx_energy_weights(float f)
{
    float g = 1.0 - f;
    return float4(g * g * g, 4.0 - 6.0 * f * f + 3.0 * f * f * f, 4.0 - 6.0 * g * g + 3.0 * g * g * g, f * f * f) / 6.0;
}

// Only the 4 x 4 basis functions nonzero at t: the whole tensor product cost each call site every term.
float2 ggx_energy_fit(float2 t)
{
    float2 x = t * 11.0 + 1.0;
    // t = 1 is the last cell's far edge, not a cell past it.
    float2 cell = clamp(floor(x), 1.0, 11.0);
    float4 wi = ggx_energy_weights(x.x - cell.x);
    float4 wj = ggx_energy_weights(x.y - cell.y);
    int first = int(cell.x - 1.0) * 14 + int(cell.y - 1.0);
    float2 e = float2(0.0);
    for (int i = 0; i < 4; i++)
    {
        float2 row = float2(0.0);
        for (int j = 0; j < 4; j++)
            row += GGX_ENERGY_COEFFICIENTS[first + i * 14 + j] * wj[j];
        e += row * wi[i];
    }
    return e;
}
