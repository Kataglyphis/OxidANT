    {"name": "bloom_tap_weight", "type": "f32", "width": 1, "abs": 1e-06, "rel": 1e-05},
    {"name": "bloom_tap_weight.sum", "type": "f32", "width": 1, "abs": 1e-06, "rel": 1e-05}
  ],
