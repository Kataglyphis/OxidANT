    {"name": "negative radiance keeps nothing", "inputs": {"exposed": [-3.0, -0.5, 1.25], "offset": [0]}, "outputs": {"bloom_bright": [0.0, 0.0, 0.25], "bloom_tap_weight": [0.227026998997], "bloom_tap_weight.sum": [0.999999415129]}},
